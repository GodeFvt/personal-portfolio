    "esbuild": "^0.28.2",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@types/pg": "8.16.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
