# Copy to the repository root as .env.production and keep it out of Git.
SITE_DOMAIN=portfolio.example.com
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CERTS_DIR=/etc/letsencrypt
NUXT_PUBLIC_SITE_URL=https://portfolio.example.com
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://portfolio:replace@database.example.com:5432/portfolio?sslmode=require
DIRECT_URL=postgresql://portfolio:replace@database.example.com:5432/portfolio?sslmode=require
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/data/media
MEDIA_UPLOAD_SECRET=replace-with-an-independent-32-character-secret
SCHEDULED_JOB_SECRET=replace-with-an-independent-32-character-secret
OAUTH_SECRET_KEYS=1:replace-with-a-base64-encoded-32-byte-key
OAUTH_ACTIVE_KEY_VERSION=1
